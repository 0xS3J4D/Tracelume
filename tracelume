#!/usr/bin/env bash
# Tracelume launcher (Linux / macOS). Windows: use tracelume.ps1.
set -euo pipefail
cd "$(dirname "$0")"
PORT="${TRACELUME_PORT:-8080}"
URL="http://127.0.0.1:${PORT}"
DC=(docker compose)

need() { command -v "$1" >/dev/null || { echo "Tracelume needs $1. Install Docker Desktop or Docker Engine first." >&2; exit 1; }; }
need docker
if ! docker info >/dev/null 2>&1; then
  if [ "$(uname -s)" = Linux ] && [ -S /var/run/docker.sock ] && ! [ -w /var/run/docker.sock ]; then
    echo "Your user may not use Docker. Run:  sudo usermod -aG docker \$USER  then log out and in again." >&2
  else
    echo "Docker is installed but not running. Start Docker and try again." >&2
  fi
  exit 1
fi
docker compose version >/dev/null 2>&1 || { echo "Docker Compose v2 is missing (package: docker-compose-plugin)." >&2; exit 1; }

# iPhone backup over USB is available on Linux hosts with a USB bus
if [ "$(uname -s)" = Linux ] && [ -d /dev/bus/usb ]; then
  export TRACELUME_USB_ACQUISITION=1
  if command -v systemctl >/dev/null && systemctl is-active --quiet usbmuxd 2>/dev/null; then
    echo "Note: the host's usbmuxd service is running and may hold connected iPhones."
    echo "      For iPhone backups in Tracelume run:  sudo systemctl stop usbmuxd"
  fi
fi

images() {  # pull prebuilt images; build only what is missing (e.g. no network to the registry)
  "${DC[@]}" "$@" pull --quiet --ignore-pull-failures || true
  "${DC[@]}" "$@" up --no-start --no-build >/dev/null 2>&1 || "${DC[@]}" "$@" up --no-start
}

mkdir -p import backups && chmod 0777 backups 2>/dev/null || true

case "${1:-start}" in
  start)
    images
    "${DC[@]}" up -d
    printf 'Waiting for Tracelume'; for _ in $(seq 60); do curl -sf "$URL/api/health" >/dev/null && break; printf '.'; sleep 1; done; echo
    echo "Tracelume is running at ${URL} (only reachable from this computer)."
    (command -v xdg-open >/dev/null && xdg-open "$URL" >/dev/null 2>&1) || (command -v open >/dev/null && open "$URL") || true ;;
  stop)   "${DC[@]}" down ;;
  status) "${DC[@]}" ps ;;
  logs)   "${DC[@]}" logs -f --tail=100 ;;
  tools)  # download (or build) every forensic tool image
    images --profile tools
    "${DC[@]}" --profile tools rm -f >/dev/null 2>&1 || true
    echo "Tool images ready." ;;
  build)  "${DC[@]}" --profile tools build ;;   # build everything from source
  update) git pull --ff-only && "$0" tools && "${DC[@]}" up -d ;;
  ai)
    # Download a model ONCE with network access, then serve it offline on the internal network.
    model="${2:-qwen2.5:7b-instruct}"
    echo "Downloading ${model} (one-time, needs internet)…"
    docker run --rm -v tracelume_ollama:/root/.ollama --entrypoint sh ollama/ollama:0.40.13 \
      -c "ollama serve >/dev/null 2>&1 & sleep 3; ollama pull '${model}'"
    "${DC[@]}" --profile ai up -d ollama
    echo "Local model ready. In Tracelume → Settings, set the model to: ${model}" ;;
  backup)
    "${DC[@]}" exec -T api python -m tracelume.backup create
    echo "Backup written to ./backups (a .sha256 checksum file sits next to it)." ;;
  restore)
    file="${2:?usage: ./tracelume restore backups/<file>.tar.gz}"
    [ -f "$file" ] || { echo "no such file: $file" >&2; exit 1; }
    echo "This REPLACES all current cases, evidence and results with the backup."
    read -r -p "Type RESTORE to continue: " ok; [ "$ok" = RESTORE ] || exit 1
    "${DC[@]}" down
    docker volume rm tracelume_db tracelume_evidence tracelume_workspace >/dev/null 2>&1 || true
    "${DC[@]}" up -d db redis
    cp "$file" backups/ 2>/dev/null || true; [ -f "$file.sha256" ] && cp "$file.sha256" backups/ 2>/dev/null || true
    "${DC[@]}" run --rm api python -m tracelume.backup restore "/backups/$(basename "$file")"
    "${DC[@]}" up -d
    echo "Restore complete." ;;
  *) cat <<USAGE
usage: ./tracelume <command>
  start            start Tracelume and open it in the browser (default)
  stop             stop all services (data is kept)
  status | logs    show service status / follow logs
  tools            download the forensic tool images (first run, and after updates)
  ai [model]       download a local AI model once, then run it offline
  backup           back up the database, evidence and results to ./backups
                   (also available in the app under Settings → Backups)
  restore <file>   restore a backup into this installation (replaces current data)
  update           update to the latest version
  build            build every image from source instead of downloading
USAGE
     exit 2 ;;
esac
